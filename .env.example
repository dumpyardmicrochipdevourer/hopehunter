# Скопировать в .env и заполнить. Значения - в менеджере паролей, не в git.
DB_PASSWORD=
BOT_TOKEN=
BOT_ADMIN_USERNAMES=
# openssl rand -base64 32. Сменить ключ = всем заново входить в hh: старые куки не расшифруются.
HH_COOKIE_KEY=
# Публичный https-адрес мини-приложения, например https://hh.example.com/ . Пусто - без приложения.
BOT_WEBAPP_URL=
